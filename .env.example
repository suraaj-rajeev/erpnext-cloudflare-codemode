# Set these as Cloudflare Worker secrets/vars; never commit real credentials.
# Base URL only, e.g. https://your-site.frappe.cloud (no trailing slash)
ERPNEXT_BASE_URL=https://your-site.frappe.cloud
# Frappe API credentials: API_KEY:API_SECRET is used as the token value.
ERPNEXT_API_KEY=replace-me
ERPNEXT_API_SECRET=replace-me
# Generate a long random token for clients connecting to this MCP server.
MCP_ACCESS_TOKEN=replace-with-a-long-random-token
